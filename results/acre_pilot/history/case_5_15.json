{
  "case_id": "5:15",
  "guideline_id": 5,
  "pair_id": null,
  "options": [
    {
      "label": "A",
      "action": "Provide oral nutritional supplementation (including between-meal snacks where appropriate) over a short term (about 3–12 weeks) to increase energy intake and modestly improve body weight, BMI and malnutrition status in the person with dementia."
    },
    {
      "label": "B",
      "action": "Provide rich finger foods as a pragmatic approach to enhance consumption and total food intake for the person with dementia in the institutional setting."
    },
    {
      "label": "C",
      "action": "Consider other non-pharmacological approaches (such as assistance with eating and drinking, person-centered mealtime care, environmental modification, and education or training) to address feeding and eating disorders and related nutritional problems in this person with dementia."
    },
    {
      "label": "D",
      "action": "Provide assistance with eating and drinking using under hand and/or direct hand feeding techniques, allowing sufficient time to finish meals, to increase meal intake and reduce feeding problem behaviors."
    },
    {
      "label": "E",
      "action": "Provide assistance with eating and drinking using available handfeeding techniques, allowing sufficient time to finish meals, recognizing that over hand feeding may be associated with more frequent feeding problem behaviors."
    },
    {
      "label": "F",
      "action": "Implement a high-quality improvement system to organize and manage mealtime feeding assistance so that staff provide more consistent assistance, helping to improve meal intake and reduce unintentional weight loss among persons with dementia."
    },
    {
      "label": "G",
      "action": "Use assistive devices or technologies that support meal preparation (e.g., technologies enabling beginning or carrying on cooking) to help the person with dementia initiate and maintain cooking and food preparation."
    },
    {
      "label": "H",
      "action": "Emphasize person-centered mealtime care, environmental modification, and caregiver education or training to address behavioral and engagement-related feeding and eating problems in the person with dementia."
    },
    {
      "label": "I",
      "action": "Implement spaced retrieval training and/or Montessori-based activities to improve hyperphagic, rapid eating, pica and other eating-related behaviors, enhance self-eating ability, and increase meal intake, with possible long-term benefits."
    },
    {
      "label": "J",
      "action": "Provide non-pharmacological individual therapeutic-cognitive intervention (cognitive-behavioral education) directed to family caregivers to improve control and reduction of eating disorders in the person with dementia."
    },
    {
      "label": "K",
      "action": "Provide intensive and longer-term education, counselling, or training on nutrition, feeding skills, and prevention of weight loss for caregivers and/or the person with dementia, using available formats (e.g., face-to-face or web-based) to slightly improve food intake and body weight."
    },
    {
      "label": "L",
      "action": "Use spaced retrieval training with a visual aid to improve 2–3 compensatory swallowing behaviors in the person with dementia during eating and drinking."
    },
    {
      "label": "M",
      "action": "Focus on environmental modification and person-centered mealtime care (e.g., pleasant and home-like environments, tailored care and choices) to improve engagement with eating and mealtime experience in this mildly affected person with dementia."
    },
    {
      "label": "N",
      "action": "Use a multi-component, individualized management approach combining interventions such as oral nutritional supplementation, food or drink modification and assistance, environmental modification, psychomotor or behavioral programs, and caregiver training, based on a geriatric assessment and, where available, recommendations from a multidisciplinary mobile dementia team."
    },
    {
      "label": "O",
      "action": "No specific non-pharmacological feeding and eating disorder intervention from this guideline is required at this time; continue general dementia care, monitor for emergence of feeding and eating disorders, and reassess if such problems develop."
    },
    {
      "label": "P",
      "action": "Insufficient explicit patient evidence to select a guideline recommendation."
    }
  ],
