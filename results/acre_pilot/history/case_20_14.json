{
  "case_id": "20:14",
  "guideline_id": 20,
  "pair_id": null,
  "options": [
    {
      "label": "A",
      "action": "Do not initiate or progress structured exercise or intradialytic exercise at this time; manage unstable condition first and follow standard haemodialysis care without added exercise."
    },
    {
      "label": "B",
      "action": "Delay starting intradialytic cycling until after the first 30 minutes of haemodialysis, then perform supervised intradialytic cycling for at least 30 minutes at a moderate intensity (Borg RPE 12–14) on each haemodialysis treatment (3 times/week), and encourage additional physical activity on non-dialysis days aiming toward a total of 150 minutes/week of moderate activity (or 75 minutes vigorous)."
    },
    {
      "label": "C",
      "action": "Provide supervised intradialytic cycling during this haemodialysis session for at least 30 minutes at a moderate intensity (Borg RPE 12–14) on each treatment (3 times/week) to improve cardiovascular health, physical function, muscular strength, blood pressure control, lipid profile and dialysis efficiency, and encourage additional interdialytic physical activity toward 150 minutes/week of moderate activity (or 75 minutes vigorous)."
    },
    {
      "label": "D",
      "action": "Encourage haemodialysis patient to perform regular physical activity outside dialysis (e.g. home-based walking or other moderate-intensity activity) aiming for 150 minutes/week of moderate intensity (or 75 minutes vigorous, or a mixture), with programmes ideally supervised by appropriately qualified staff when available, while addressing individual patient and staff barriers to optimise participation and adherence."
    },
    {
      "label": "E",
      "action": "Avoid contact sports and activities with high risk of traumatic graft damage, avoid prolonged extreme endurance events unless carefully considered with a transplant and sports medicine team, and avoid sport‑enhancing dietary supplements; otherwise encourage only moderate, non-contact physical activity within standard guidelines."
    },
    {
      "label": "F",
      "action": "Do not implement additional intensive physiotherapy or structured exercise beyond standard early mobility encouragement; continue standard care mobilization without extra intensive exercise, as early intensive physiotherapy has not shown added benefit."
    },
    {
      "label": "G",
      "action": "Offer prehabilitation: encourage and, if possible, supervise structured cardiovascular and strength exercise (at least 3 times per week) to increase pre-transplant physical activity levels and potentially aid recovery post-transplant, aiming for at least 150 minutes/week of moderate‑to‑vigorous physical activity (or 75 minutes vigorous)."
    },
    {
      "label": "H",
      "action": "Implement a supervised, individualised structured exercise programme performed at least 3 times/week, including aerobic exercise at >60% of maximum (heart rate or VO2peak) and resistance training of upper and lower body at >60% 1-RM at least 2 times/week, progressing volume gradually, to enhance cardiorespiratory fitness, muscular strength, physical function, HDL levels and health-related quality of life while aiming for ≥150 minutes/week of moderate-to-vigorous physical activity."
    },
    {
      "label": "I",
      "action": "Encourage general physical activity toward 150 minutes/week of moderate-to-vigorous physical activity (or 75 minutes vigorous), aiming to reduce all‑cause and cardiovascular mortality and improve functional outcomes, and address individual barriers and activators to increase uptake; structured exercise can be advised but may be unsupervised or adapted to the patient’s circumstances."
    },
    {
      "label": "J",
      "action": "Do not prescribe progressive exercise beyond gentle activity; manage contraindications and stabilise comorbidities first, while offering only cautious basic physical activity as tolerated."
    },
    {
      "label": "K",
      "action": "Advise the patient to maintain current aerobic activity levels (≥150 minutes/week moderate or 75 minutes vigorous), ensure participation in muscle strength, balance and flexibility activities on at least 2 days per week, and minimise sedentary time by breaking up prolonged sitting; a prescribed combination of aerobic and muscle strengthening should be used to improve or maintain muscle function, blood pressure, physical function, and quality of life."
    },
    {
      "label": "L",
      "action": "Encourage the patient to gradually increase physical activity from current levels toward 150 minutes/week of moderate intensity aerobic activity (or 75 minutes vigorous, or combination), participate in daily physical activity, undertake strength, balance and flexibility activities at least 2 days per week, and break up prolonged sedentary periods with light activity or standing; use a prescribed combination of aerobic and muscle strengthening to improve muscle function, blood pressure, physical function, and health-related quality of life."
    },
    {
      "label": "M",
      "action": "The patient does not fall into the specified CKD non-dialysis, haemodialysis, or transplant groups covered by this guideline; apply other appropriate clinical guidelines."
    },
    {
      "label": "N",
      "action": "This guideline does not apply because the patient does not have chronic kidney disease or kidney replacement therapy."
    },
    {
      "label": "O",
      "action": "Insufficient explicit patient evidence to select a guideline recommendation."
    }
  ],
