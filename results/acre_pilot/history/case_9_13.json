{
  "case_id": "9:13",
  "guideline_id": 9,
  "pair_id": null,
  "options": [
    {
      "label": "A",
      "action": "Use neoadjuvant imatinib to downsize tumor, then proceed to surgical excision with goal of negative margins."
    },
    {
      "label": "B",
      "action": "Proceed directly to surgical excision with goal of negative margins despite functional/cosmetic concerns, with multidisciplinary planning."
    },
    {
      "label": "C",
      "action": "Margins clear after Mohs/PDEMA: no adjuvant radiation therapy; delay or perform reconstruction only after margin clearance and begin routine follow-up."
    },
    {
      "label": "D",
      "action": "Perform re-resection using Mohs/PDEMA or combined techniques to achieve clear margins before reconstruction; avoid wide undermining until margins are clear."
    },
    {
      "label": "E",
      "action": "Positive margins, further resection not feasible, prior RT given: manage with multidisciplinary consultation for other systemic or palliative options (e.g., imatinib) and surveillance."
    },
    {
      "label": "F",
      "action": "Positive margins, further resection not feasible, no prior RT: give adjuvant radiation therapy (50–60 Gy for indeterminate/positive margins, up to 66 Gy for gross tumor) with wide fields."
    },
    {
      "label": "G",
      "action": "Negative margins achieved with Mohs/PDEMA: no adjuvant radiation therapy; begin routine follow-up and consider delayed reconstruction after verification of clear margins."
    },
    {
      "label": "H",
      "action": "Negative but close (<1 cm) margins without Mohs/PDEMA: consider adjuvant radiation therapy with fields extending 3–5 cm beyond surgical margins when feasible."
    },
    {
      "label": "I",
      "action": "Negative and adequately wide (≥1 cm) margins without Mohs/PDEMA: no adjuvant treatment; delay extensive reconstruction until margin clearance and start routine follow-up."
    },
    {
      "label": "J",
      "action": "Perform re-resection (preferably with meticulous margin control) aiming for negative margins; avoid wide undermining and delay tissue rearrangement until margins are clear."
    },
    {
      "label": "K",
      "action": "Positive margins after WLE, further resection not feasible, prior RT given: manage with multidisciplinary consultation for other local/systemic options (e.g., imatinib) and close surveillance."
    },
    {
      "label": "L",
      "action": "Positive margins after WLE, further resection not feasible, no prior RT: give adjuvant radiation therapy (50–60 Gy for indeterminate/positive margins, up to 66 Gy for gross tumor) with wide fields."
    },
    {
      "label": "M",
      "action": "Resect recurrent tumor whenever possible, using techniques emphasizing complete margin assessment; consider adjuvant radiation therapy if margins are positive/indeterminate and further resection is not feasible."
    },
    {
      "label": "N",
      "action": "Recurrent, unresectable tumor with prior RT: consider systemic imatinib mesylate or other palliative/systemic options; maintain close clinical follow-up."
    },
    {
      "label": "O",
      "action": "Recurrent, unresectable tumor without prior RT: use definitive radiation therapy (50–60 Gy for indeterminate/positive margins, up to 66 Gy for gross tumor) as primary local treatment."
    },
    {
      "label": "P",
      "action": "For unresectable disease after multiple resections or when further surgery would cause unacceptable functional/cosmetic outcomes: consider systemic imatinib mesylate; use RT if not given previously and surgery is not feasible."
    },
    {
      "label": "Q",
      "action": "If not clearly unresectable and not recurrent after multiple resections, reassess resectability and manage per primary surgical pathway aiming for complete excision with clear margins."
    },
    {
      "label": "R",
      "action": "Metastatic DFSP: perform multidisciplinary consultation; manage according to soft tissue sarcoma guidelines, with consideration of systemic imatinib and other multimodal therapies including CT imaging of draining nodal basin and chest."
    },
    {
      "label": "S",
      "action": "Non-localized, non-metastatic pattern not clearly defined (e.g., regional spread only): obtain multidisciplinary consultation and follow soft tissue sarcoma guidelines for multimodal therapy and surveillance."
    },
    {
      "label": "T",
      "action": "Insufficient explicit patient evidence to select a guideline recommendation."
    }
  ],
