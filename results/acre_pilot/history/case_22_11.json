  "options": [
    {
      "label": "A",
      "action": "Offer repeat 75-g OGTT at 24–28 weeks' gestation."
    },
    {
      "label": "B",
      "action": "Plan repeat 75-g OGTT at 24–28 weeks' gestation when the patient reaches that gestational window."
    },
    {
      "label": "C",
      "action": "Manage hyperglycaemia per applicable gestational diabetes/diabetes care pathways (guideline provides screening steps but no further PCOS-specific management algorithm)."
    },
    {
      "label": "D",
      "action": "Follow national recommendations/resources for ongoing antenatal screening and monitoring in women with PCOS."
    },
    {
      "label": "E",
      "action": "Offer a 75-g OGTT at antenatal booking or before the 20th week of pregnancy."
    },
    {
      "label": "F",
      "action": "Follow national recommendations/resources for antenatal screening and monitoring; guideline specifies OGTT should be offered at booking/before 20 weeks if not done preconception."
    },
    {
      "label": "G",
      "action": "Perform a 75-g OGTT to assess glycaemic status (every 1–3 years depending on risk factors)."
    },
    {
      "label": "H",
      "action": "Measure blood pressure annually."
    },
    {
      "label": "I",
      "action": "Continue postpregnancy follow-up aligned with general population recommendations, including monitoring weight, smoking, alcohol, diet, exercise, sleep, and mental/emotional/sexual health."
    },
    {
      "label": "J",
      "action": "Continue/implement lifestyle modifications and weight management at preconception; ensure routine preconception risk assessment has been completed (including OGTT already performed)."
    },
    {
      "label": "K",
      "action": "Assess impaired glucose tolerance and type 2 diabetes with a 75-g OGTT at preconception."
    },
    {
      "label": "L",
      "action": "Implement lifestyle modifications and weight management aiming for 5% weight loss for BMI >25 kg/m²."
    },
    {
      "label": "M",
      "action": "Proceed with common preconception risk assessments with adequate time to intervene; optimize weight, diet, exercise, sleep, and mental/emotional health aligned with general population recommendations."
    },
    {
      "label": "N",
      "action": "Guideline pathway not applicable: this guidance is focused on women with PCOS at preconception, during pregnancy, and postpregnancy."
    },
    {
      "label": "O",
      "action": "Insufficient explicit patient evidence to select a guideline recommendation."
    }
