{"rule_id": "N09", "text": "Thyroid carcinoma invades at least 4 vessels.", "conditions": [{"condition_id": "c1", "field": "vessels", "text": "vessels ge 4", "criterion_kind": "inclusion", "numeric": {"field": "vessels", "operator": ">=", "value": 4}}], "logic": {"op": "AND", "args": ["c1"]}, "exceptions": [], "source_span": {"start": 0, "end": 45, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N05", "text": "Serum testosterone is less than 50 ng/dL.", "conditions": [{"condition_id": "c1", "field": "testosterone", "text": "testosterone lt 50", "criterion_kind": "inclusion", "numeric": {"field": "testosterone", "operator": "<", "value": 50}}], "logic": {"op": "AND", "args": ["c1"]}, "exceptions": [], "source_span": {"start": 0, "end": 41, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N03", "text": "PCI is at most 10 AND disease is stable or improved AND metastatic progression is absent AND extraperitoneal disease is absent.", "conditions": [{"condition_id": "c1", "field": "pci", "text": "pci le 10", "criterion_kind": "inclusion", "numeric": {"field": "pci", "operator": "<=", "value": 10}}, {"condition_id": "c2", "field": "stable", "text": "stable eq positive", "criterion_kind": "inclusion"}, {"condition_id": "c3", "field": "progression", "text": "progression eq negative", "criterion_kind": "inclusion"}, {"condition_id": "c4", "field": "extra", "text": "extra eq negative", "criterion_kind": "inclusion"}], "logic": {"op": "AND", "args": ["c1", "c2", "c3", "c4"]}, "exceptions": [], "source_span": {"start": 0, "end": 127, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N07", "text": "The largest solid pulmonary nodule is between 6 and 8 mm, inclusive.", "conditions": [{"condition_id": "c1", "field": "lung_mm", "text": "lung_mm ge 6", "criterion_kind": "inclusion", "numeric": {"field": "lung_mm", "operator": ">=", "value": 6}}, {"condition_id": "c2", "field": "lung_mm", "text": "lung_mm le 8", "criterion_kind": "inclusion", "numeric": {"field": "lung_mm", "operator": "<=", "value": 8}}], "logic": {"op": "AND", "args": ["c1", "c2"]}, "exceptions": [], "source_span": {"start": 0, "end": 68, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N01", "text": "AFP is positive OR the largest liver nodule on ultrasound is at least 10 mm.", "conditions": [{"condition_id": "c1", "field": "afp", "text": "afp eq positive", "criterion_kind": "inclusion"}, {"condition_id": "c2", "field": "liver_mm", "text": "liver_mm ge 10", "criterion_kind": "inclusion", "numeric": {"field": "liver_mm", "operator": ">=", "value": 10}}], "logic": {"op": "OR", "args": ["c1", "c2"]}, "exceptions": [], "source_span": {"start": 0, "end": 76, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N08", "text": "Primary thyroid carcinoma is greater than 4 cm OR lymphatic invasion is present OR an additional macroscopic thyroid tumor focus exceeds 1 cm OR poorly differentiated/high-grade carcinoma features are present.", "conditions": [{"condition_id": "c1", "field": "thyroid_cm", "text": "thyroid_cm gt 4", "criterion_kind": "inclusion", "numeric": {"field": "thyroid_cm", "operator": ">", "value": 4}}, {"condition_id": "c2", "field": "lymphatic", "text": "lymphatic eq positive", "criterion_kind": "inclusion"}, {"condition_id": "c3", "field": "multifocal_cm", "text": "multifocal_cm gt 1", "criterion_kind": "inclusion", "numeric": {"field": "multifocal_cm", "operator": ">", "value": 1}}, {"condition_id": "c4", "field": "highgrade", "text": "highgrade eq positive", "criterion_kind": "inclusion"}], "logic": {"op": "OR", "args": ["c1", "c2", "c3", "c4"]}, "exceptions": [], "source_span": {"start": 0, "end": 209, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N06", "text": "The solid component of the part-solid pulmonary nodule is at least 6 mm.", "conditions": [{"condition_id": "c1", "field": "solid_mm", "text": "solid_mm ge 6", "criterion_kind": "inclusion", "numeric": {"field": "solid_mm", "operator": ">=", "value": 6}}], "logic": {"op": "AND", "args": ["c1"]}, "exceptions": [], "source_span": {"start": 0, "end": 72, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N04", "text": "The Peritoneal Cancer Index is greater than 10.", "conditions": [{"condition_id": "c1", "field": "pci", "text": "pci gt 10", "criterion_kind": "inclusion", "numeric": {"field": "pci", "operator": ">", "value": 10}}], "logic": {"op": "AND", "args": ["c1"]}, "exceptions": [], "source_span": {"start": 0, "end": 47, "unit": "character", "source": "V3_candidate_data4"}}
{"rule_id": "N02", "text": "The largest liver nodule on ultrasound is less than 10 mm.", "conditions": [{"condition_id": "c1", "field": "liver_mm", "text": "liver_mm lt 10", "criterion_kind": "inclusion", "numeric": {"field": "liver_mm", "operator": "<", "value": 10}}], "logic": {"op": "AND", "args": ["c1"]}, "exceptions": [], "source_span": {"start": 0, "end": 58, "unit": "character", "source": "V3_candidate_data4"}}
