{"rule_id": "V04", "source_row": 62, "source_node_index": 3, "text": "ALL: preoperative breast clinical T stage 1 to 3 inclusive; clinical N stage 0; no preoperative chemotherapy; 1 to 2 positive sentinel nodes inclusive; whole breast radiotherapy planned.", "schema_gold": {"mode": "all", "conditions": [{"field": "ct", "op": "ge", "value": 1}, {"field": "ct", "op": "le", "value": 3}, {"field": "cn", "op": "eq", "value": 0}, {"field": "preop_chemo", "op": "eq", "value": "negative"}, {"field": "sln_count", "op": "ge", "value": 1}, {"field": "sln_count", "op": "le", "value": 2}, {"field": "wbrt", "op": "eq", "value": "positive"}], "exceptions": []}, "scope": "complete stated predicate", "source_node_sha256": "43349f1a85dba366a8ede7e84a17c486eb888bf96886e29537f247b8075893b0"}
{"rule_id": "V05", "source_row": 65, "source_node_index": 2, "text": "Breast surgical pathology has zero positive axillary nodes AND invasive tumor diameter at most 5 cm AND closest resection margin at least 1 mm.", "schema_gold": {"mode": "all", "conditions": [{"field": "ax_nodes", "op": "eq", "value": 0}, {"field": "tumor_cm", "op": "le", "value": 5}, {"field": "margin_mm", "op": "ge", "value": 1}], "exceptions": []}, "scope": "complete stated predicate", "source_node_sha256": "d6eb090b9c2d2171fbf809c5aba79a8481ab1ec5c71ce43531fe5ce0fe5d3e46"}
{"rule_id": "V06", "source_row": 71, "source_node_index": 3, "text": "Clinical breast nodes were positive before neoadjuvant treatment AND postoperative nodes are ypN0.", "schema_gold": {"mode": "all", "conditions": [{"field": "cn", "op": "ge", "value": 1}, {"field": "ypn", "op": "eq", "value": 0}], "exceptions": []}, "scope": "complete stated predicate", "source_node_sha256": "fb85f7bde13f9d563ad46a1853ffbe58018fcc9d910098dcf5dff2713f8efb2d"}
