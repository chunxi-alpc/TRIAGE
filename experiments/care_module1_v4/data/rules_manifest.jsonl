{"rule_id": "V11", "source_row": 211, "source_node_index": 2, "text": "Thyroid lobectomy margins are negative AND postoperative imaging shows no contralateral thyroid lesion AND no suspicious cervical lymph node.", "schema_gold": {"mode": "all", "conditions": [{"field": "margin", "op": "eq", "value": "negative"}, {"field": "contra", "op": "eq", "value": "negative"}, {"field": "susp_nodes", "op": "eq", "value": "negative"}], "exceptions": []}, "scope": "three-condition branch only, excludes alternative NIFTP branch", "source_node_sha256": "ea00e72b1ca19f7f30d03342c3b84eeb2f490f04ad735ed4b05089acdf461be2"}
